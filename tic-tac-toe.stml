<!DOCTYPE html><html><head><title>Tic-Tac-Toe</title><style>body{text-align:center;font-family:sans-serif}.board{display:grid;grid-template-columns:repeat(3,100px);grid-gap:5px;justify-content:center;margin-top:20px}.cell{width:100px;height:100px;border:1px solid #000;display:flex;align-items:center;justify-content:center;font-size:2em;cursor:pointer}</style></head><body><h1>Tic-Tac-Toe</h1><div class='board' id='board'></div><script>const board=document.getElementById('board');let turn='X';for(let i=0;i<9;i++){const cell=document.createElement('div');cell.className='cell';cell.onclick=()=>{if(!cell.innerText){cell.innerText=turn;turn=turn==='X'?'O':'X';}}board.appendChild(cell);}</script></body></html>